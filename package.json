{
	"name": "serenity-now",
	"version": "0.2.1",
	"description": "A monorepo dependency management tool that keeps workspace dependencies in sync",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": "./dist/cli.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsx src/cli.ts",
		"test": "vitest --coverage",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write . && tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run check && npm test && npm run build"
	},
	"keywords": [
		"monorepo",
		"workspace",
		"dependencies",
		"typescript",
		"tsconfig",
		"package-json"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/billie-coop/serenity-now.git"
	},
	"bugs": {
		"url": "https://github.com/billie-coop/serenity-now/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"overrides": {
		"rollup": "4.60.3",
		"picomatch": "4.0.4"
	},
	"dependencies": {
		"fast-glob": "3.3.3",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "24.12.3",
		"@vitest/coverage-v8": "4.1.5",
		"tsup": "^8.5.1",
		"tsx": "4.21.0",
		"vitest": "4.1.5"
	}
}
