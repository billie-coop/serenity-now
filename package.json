{
	"name": "serenity-now",
	"version": "0.3.0",
	"description": "Keeps TypeScript monorepo workspace dependencies, tsconfig paths and project references in sync with your imports",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"serenity-now": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"dev": "tsx src/cli.ts",
		"test": "vitest --coverage",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write . && tsc",
		"typecheck": "tsc",
		"prepublishOnly": "npm run check && vitest run && npm run build"
	},
	"keywords": [
		"monorepo",
		"workspace",
		"dependencies",
		"typescript",
		"tsconfig",
		"package-json"
	],
	"author": "",
	"homepage": "https://billie-coop.github.io/serenity-now/",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/billie-coop/serenity-now.git"
	},
	"bugs": {
		"url": "https://github.com/billie-coop/serenity-now/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"overrides": {
		"picomatch": "$picomatch"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1",
		"picomatch": "4.0.7",
		"tinyglobby": "0.2.17",
		"typescript": "7.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "24.12.3",
		"@types/picomatch": "4.0.3",
		"@vitest/coverage-v8": "5.0.3",
		"tsx": "4.23.15",
		"vitest": "5.0.3"
	}
}
