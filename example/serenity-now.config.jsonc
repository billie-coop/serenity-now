{
	// Example Serenity Now configuration
	"workspaceTypes": {
		"apps/*": {
			"type": "app",
			"packageJsonTemplate": {
				"private": true
			},
			"tsconfigTemplate": {
				"extends": "../../tsconfig.base.json",
				"compilerOptions": {
					"outDir": "../../dist/{{projectDir}}"
				}
			}
		},
		"packages/*": {
			"type": "shared-package",
			"enforceNamePrefix": "@example/",
			"packageJsonTemplate": {
				"main": "src/index.ts",
				"types": "src/index.ts"
			},
			"tsconfigTemplate": {
				"extends": "../../tsconfig.base.json",
				"include": ["src/**/*"],
				"compilerOptions": {
					"outDir": "dist"
				}
			}
		}
	},

	// Import patterns to ignore
	"ignoreImports": ["@example/generated-*"]
}
